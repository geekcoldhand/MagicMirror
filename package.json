{
	"name": "magicmirror-mvp",
	"author": "Horatious",
	"description": "MagicMirror² MVP - Minimal Implementation",
	"main": "js/electron.js",
	"scripts": {
		"start": "DISPLAY=\"${DISPLAY:=:0}\" ./node_modules/.bin/electron js/electron.js",
		"start:dev": "DISPLAY=\"${DISPLAY:=:0}\" ./node_modules/.bin/electron js/electron.js dev",
		"server": "node ./serveronly",
		"install-vendor": "cd vendor && npm install --loglevel=error"
	},
	"dependencies": {
		"express": "^4.18.2",
		"socket.io": "^4.7.1",
		"node-fetch": "^2.6.12",
		"moment": "^2.29.4",
		"luxon": "^1.28.1",
		"node-ical": "^0.16.1",
		"digest-fetch": "^2.0.3",
		"console-stamp": "^3.1.1",
		"colors": "^1.4.0",
		"helmet": "^7.0.0",
		"express-ipfilter": "^1.3.1",
		"iconv-lite": "^0.6.3",
		"feedme": "^2.0.2",
		"module-alias": "^2.2.3"
	},
	"optionalDependencies": {
		"electron": "^25.2.0"
	},
	"_moduleAliases": {
		"node_helper": "js/node_helper.js",
		"logger": "js/logger.js",
		"fetch": "js/fetch.js"
	},
	"engines": {
		"node": ">=16"
	}
}
